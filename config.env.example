# Site settings for scripts/serve.sh. Copy to config.env (next to this file) or point DSV41_CONFIG at a copy.
# Sourced by bash: plain VAR=value lines. Every <PLACEHOLDER> must be replaced; the script refuses to start while one
# is left.

# --- the two nodes, rank 0 first --------------------------------------------------------------------------------------
NODES="<NODE0_SSH> <NODE1_SSH>"   # ssh aliases, each without a password prompt (a node that is this host runs locally)
MASTER_IP="<NODE0_LINK_IP>"       # rank 0's address on the RoCE link
TP_PORT=29780                     # rank 0's rendezvous port (unauthenticated: keep it on the private link)
RDMA_HCA="<RDMA_DEV0>,<RDMA_DEV1>"  # the link's RDMA devices (ibv_devices), the same names on both nodes
NET_IF="<LINK_IFNAME>"            # NCCL's socket interface on the link
# The engine's RDMA ring opens GID index 5 of each RDMA device (port 1), and NCCL is set to the same index:
# `scripts/serve.sh preflight` checks that both nodes have a RoCE v2 address there (RUNNING.md section 2).

# --- paths, the same on both nodes ------------------------------------------------------------------------------------
MODEL_DIR="<MODEL_DIR>"           # bertholomus/DeepSeek-V4.1-Flash-1017-EXL3-2.5bpw, readied by tools/serving_1017.py
ENGRAM_DIR="<ENGRAM_DIR>"         # DeepSeek-V4.1-Flash-1017's original shards 47 and 48 (the Engram tables)
ENGINE_DIR="<ENGINE_DIR>"         # tensorfold-native, tf-dsv41-lanes and rdma_gather.fatbin from the engine build
KIT_DIR="<KIT_DIR>"               # the kernel kit: aot/, cubins/, rope-*.f32, rope.json, engram.json, vision/, grammar/
CACHE_DIR="<CACHE_DIR>"           # holds rank-cache/ (each rank's weight file) and dsv41_token_map.json
LOG_DIR="<LOG_DIR>"
IMAGE=nvcr.io/nvidia/pytorch:26.07-py3

# --- HTTP on rank 0 ---------------------------------------------------------------------------------------------------
HOST=127.0.0.1                    # 0.0.0.0 serves the network: then also pass --api-key-file (SERVER_FLAGS)
PORT=18896
SERVED_NAME=DeepSeek-V4.1-Flash-1017-TP2
SERVER_FLAGS="--thinking --max-tokens 32768 --temperature 1.0 --top-p 0.95 --top-k 20"

# --- the served settings, as measured in README.md --------------------------------------------------------------------
CONTEXT=1048576                   # a request's positions at most
WINDOW=2097152                    # the streams' shared positions (both ranks' TF_DS_WINDOW, rank 1's --pool)
# The served window left 11.7 GiB free on rank 0's node at the lowest on ours, during a 1M-token prompt. Each
# 1,048,576 positions less frees 0.87 GiB a node; we measured only the served 2,097,152.
STREAMS=8                         # streams decoded together (TF_DS_STREAMS, rank 1's --streams)
ROUND_ROWS=16                     # a round's rows (TF_DS_ROUND_ROWS, rank 1's --round-rows)
PARALLEL=8                        # requests rank 0 serves at once
# Both ranks' other variables, as served:
ENGINE_ENV="TF_DS_GRAPHS=1 TF_DS_HC_SIDE=1 TF_DS_L2_PREFETCH=1 TF_DS_ENGRAM_AIO=1 TF_DS_REPLAY_FLOOR=1 TF_DS_IDX_SPLIT=1 TENSORFOLD_PLAIN_SPECIALS=1 TENSORFOLD_GRAMMAR_LIB=/kit/grammar/libtfgrammar.so TENSORFOLD_SSE_KEEPALIVE=15 TENSORFOLD_STATS_EVERY=60 TF_DS_PROMPT_ALIAS=1"
RANK0_FLAGS="--prompt-cache-gib 2"  # rank 0's own flags, after SERVER_FLAGS: the kept prompt states may take 2 GiB
